<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UniversalConverter.Desktop"
        x:Class="UniversalConverter.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding Text.AppName}" Width="1060" Height="760" MinWidth="740" MinHeight="540">
  <Window.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="212,*">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="8,12,0,32" Spacing="4">
          <TextBlock Text="{Binding Text.AppName}" TextWrapping="Wrap" FontSize="26" FontWeight="Bold" />
        </StackPanel>
        <ListBox SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" SelectionMode="AlwaysSelected" VerticalAlignment="Top">
          <ListBoxItem AutomationProperties.AutomationId="NavDashboard" AutomationProperties.Name="{Binding Text.Dashboard}" Content="{Binding Text.Dashboard}" />
          <ListBoxItem AutomationProperties.AutomationId="NavConvert" AutomationProperties.Name="{Binding Text.Convert}" Content="{Binding Text.Convert}" />
          <ListBoxItem AutomationProperties.AutomationId="NavQueue" AutomationProperties.Name="{Binding Text.Queue}" Content="{Binding Text.Queue}" />
          <ListBoxItem AutomationProperties.AutomationId="NavHistory" AutomationProperties.Name="{Binding Text.History}" Content="{Binding Text.History}" />
          <ListBoxItem AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="{Binding Text.Settings}" Content="{Binding Text.Settings}" />
          <ListBoxItem AutomationProperties.AutomationId="NavAbout" AutomationProperties.Name="{Binding Text.About}" Content="{Binding Text.About}" />
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="32,28" RowSpacing="18">
      <TextBlock Classes="title" AutomationProperties.AutomationId="PageTitle" Text="{Binding PageTitle}" />
      <Border Grid.Row="1" Classes="panel" Padding="16,10">
        <TextBlock Classes="secondary" AutomationProperties.AutomationId="SimulationBanner" Text="{Binding Text.ImageBanner}" />
      </Border>
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
        <Panel>
          <StackPanel IsVisible="{Binding IsDashboard}" Spacing="16">
            <Border Classes="panel">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Text.DashboardHeading}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Classes="secondary" Text="{Binding Text.DashboardIntro}" />
                <Button Classes="accent" Content="{Binding Text.OpenConvert}" Command="{Binding OpenConvertCommand}" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding QueueSummary}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsConvert}" Spacing="14">
            <Border Classes="panel" Background="Transparent" x:Name="DropZone" DragDrop.AllowDrop="True">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Text.DropTitle}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Classes="secondary" Text="{Binding Text.SupportedImages}" />
                <Button x:Name="ChooseFilesButton" AutomationProperties.AutomationId="ChooseFiles" Content="{Binding Text.ChooseFiles}" Click="OnChooseFiles" IsEnabled="{Binding CanEditFiles}" />
              </StackPanel>
            </Border>
            <TextBlock AutomationProperties.AutomationId="FileSummary" Text="{Binding FileSummary}" />
            <TextBlock Classes="secondary" IsVisible="{Binding !HasFiles}" Text="{Binding Text.FilesEmpty}" />
            <ListBox x:Name="InputList" AutomationProperties.AutomationId="InputFiles"
                     AutomationProperties.Name="{Binding Text.FileList}"
                     ItemsSource="{Binding FileRows}" SelectionMode="Multiple" MaxHeight="280"
                     IsEnabled="{Binding CanEditFiles}" KeyDown="OnFileListKeyDown" SelectionChanged="OnFileSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:FileRow">
                  <StackPanel Spacing="2" Margin="0,4" ToolTip.Tip="{Binding Path}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="secondary" TextWrapping="NoWrap" Text="{Binding Metadata}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="secondary" TextWrapping="NoWrap" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="secondary" TextWrapping="NoWrap" Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding OutputPath}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel ItemSpacing="8" LineSpacing="8" IsEnabled="{Binding CanEditFiles}" IsVisible="{Binding HasFiles}">
              <Button x:Name="RemoveSelectedButton" IsEnabled="False" AutomationProperties.AutomationId="RemoveSelected" Content="{Binding Text.RemoveSelected}" Click="OnRemoveSelected" />
              <Button AutomationProperties.AutomationId="ClearFiles" Content="{Binding Text.ClearFiles}" Click="OnClearFiles" />
            </WrapPanel>
            <Border Classes="panel" Padding="16" IsEnabled="{Binding CanEditFiles}">
              <StackPanel Spacing="10">
                <WrapPanel ItemSpacing="12" LineSpacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Text.TargetFormat}" />
                    <ComboBox AutomationProperties.AutomationId="TargetFormatPicker" AutomationProperties.Name="{Binding Text.TargetFormat}"
                              ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:TargetOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Text.CollisionPolicy}" />
                    <ComboBox AutomationProperties.AutomationId="CollisionPolicyPicker"
                              AutomationProperties.Name="{Binding Text.CollisionPolicy}" SelectedIndex="{Binding CollisionIndex, Mode=TwoWay}">
                      <ComboBoxItem Content="{Binding Text.CollisionRename}" />
                      <ComboBoxItem Content="{Binding Text.CollisionSkip}" />
                    </ComboBox>
                  </StackPanel>
                </WrapPanel>
                <StackPanel Spacing="4" IsVisible="{Binding ShowsQuality}">
                  <TextBlock Text="{Binding Text.ImageQuality}" />
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Quality}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            AutomationProperties.AutomationId="ImageQuality" AutomationProperties.Name="{Binding Text.ImageQuality}"
                            Value="{Binding Quality, Mode=TwoWay}" />
                  </DockPanel>
                </StackPanel>
                <TextBlock Classes="secondary" IsVisible="{Binding ShowsJpegWarning}" Text="{Binding Text.JpegWhiteBackground}" />
                <TextBlock Text="{Binding Text.OutputFolder}" />
                <TextBlock AutomationProperties.AutomationId="OutputFolderPath" Text="{Binding DestinationLabel}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding DestinationLabel}" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button AutomationProperties.AutomationId="ChooseOutputFolder" Content="{Binding Text.ChooseOutputFolder}" Click="OnChooseOutputFolder" />
                  <Button Content="{Binding Text.ResetOutputFolder}" Command="{Binding UseSourceFoldersCommand}" IsVisible="{Binding HasCustomFolder}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="accent" AutomationProperties.AutomationId="ConvertImages" Content="{Binding Text.ConvertImages}"
                      Command="{Binding ConvertImagesCommand}" IsEnabled="{Binding CanConvertFiles}" />
              <Button AutomationProperties.AutomationId="QueueSimulation" Content="{Binding Text.QueueSimulation}"
                      Command="{Binding QueueSimulationCommand}" IsEnabled="{Binding CanQueueFiles}" />
              <Button Content="{Binding Text.RefreshPreview}" Command="{Binding RefreshPreviewCommand}"
                      IsEnabled="{Binding CanEditFiles}" IsVisible="{Binding HasFiles}" />
            </WrapPanel>
            <TextBlock Classes="secondary" Text="{Binding Text.PreparingFiles}" IsVisible="{Binding IsPreparing}" />
            <TextBlock Classes="secondary" AutomationProperties.AutomationId="InputMessage" Text="{Binding InputMessage}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsQueue}" Spacing="12">
            <TextBlock Classes="secondary" Text="{Binding QueueSummary}" />
            <TextBlock Classes="secondary" Text="{Binding Text.QueueEmpty}" IsVisible="{Binding !HasJobs}" />
            <StackPanel Spacing="5" IsVisible="{Binding HasJobs}">
              <TextBlock Text="{Binding QueueProgressText}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding QueueProgress}" IsIndeterminate="{Binding QueueIndeterminate}" AutomationProperties.Name="{Binding QueueProgressText}" />
            </StackPanel>
            <ItemsControl AutomationProperties.AutomationId="ActiveJobs" ItemsSource="{Binding ActiveJobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:JobRow">
                  <Border Classes="panel" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="secondary" AutomationProperties.AutomationId="JobStatus" Text="{Binding Status}" />
                        <TextBlock Classes="secondary" Text="{Binding Mode}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="{Binding CancelLabel}" Command="{Binding Cancel}" IsEnabled="{Binding CanCancel}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding QueueResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:JobRow">
                  <Border Classes="panel" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="secondary" Text="{Binding Mode}" />
                      <TextBlock Classes="secondary" Text="{Binding Status}" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsHistory}" Spacing="12">
            <TextBlock Classes="secondary" Text="{Binding HistoryMessage}" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Text.ImageHistory}" />
            <ItemsControl ItemsSource="{Binding ImageHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:JobRow">
                  <Border Classes="panel" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="secondary" Text="{Binding Status}" />
                      <TextBlock Classes="secondary" Text="{Binding Timing}" />
                      <TextBlock Classes="secondary" Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Output}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Output}" />
                      <Button Content="{Binding LocationLabel}" Command="{Binding OpenLocation}" IsVisible="{Binding HasOutput}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Text.SimulationHistory}" IsVisible="{Binding HasSimulationHistory}" />
            <TextBlock Classes="secondary" Text="{Binding Text.HistoryNote}" IsVisible="{Binding HasSimulationHistory}" />
            <TextBlock Classes="secondary" Text="{Binding Text.HistoryEmpty}" IsVisible="{Binding !HasFinishedJobs}" />
            <ItemsControl AutomationProperties.AutomationId="FinishedJobs" ItemsSource="{Binding FinishedJobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:JobRow">
                  <Border Classes="panel" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="secondary" Text="{Binding Status}" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsSettings}" Spacing="10">
            <TextBlock Classes="secondary" Text="{Binding SettingsLoadMessage}" />
            <TextBlock Text="{Binding Text.Language}" FontSize="20" FontWeight="SemiBold" />
            <ListBox AutomationProperties.AutomationId="LanguagePicker" AutomationProperties.Name="{Binding Text.Language}"
                     SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" SelectionMode="AlwaysSelected"
                     HorizontalAlignment="Left" IsEnabled="{Binding PreferencesLoaded}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBoxItem AutomationProperties.AutomationId="LanguageEnglish" AutomationProperties.Name="{Binding Text.EnglishName}" Content="{Binding Text.EnglishName}" />
              <ListBoxItem AutomationProperties.AutomationId="LanguageTurkish" AutomationProperties.Name="{Binding Text.TurkishName}" Content="{Binding Text.TurkishName}" />
            </ListBox>
            <TextBlock Classes="secondary" AutomationProperties.AutomationId="LanguageMessage" Text="{Binding LanguageMessage}" />
            <TextBlock Text="{Binding Text.Appearance}" FontSize="20" FontWeight="SemiBold" />
            <ComboBox AutomationProperties.Name="{Binding Text.Appearance}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                      IsEnabled="{Binding PreferencesLoaded}">
              <ComboBoxItem Content="{Binding Text.ThemeSystem}" />
              <ComboBoxItem Content="{Binding Text.ThemeLight}" />
              <ComboBoxItem Content="{Binding Text.ThemeDark}" />
            </ComboBox>
            <Button Content="{Binding Text.SaveTheme}" Command="{Binding SaveThemeCommand}" IsEnabled="{Binding PreferencesLoaded}" />
            <TextBlock Classes="secondary" Text="{Binding ThemeMessage}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsAbout}" Spacing="10">
            <TextBlock Text="{Binding Text.AppName}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Classes="secondary" Text="{Binding Text.AboutDescription}" />
            <TextBlock Classes="secondary" Text="{Binding Platform}" />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
