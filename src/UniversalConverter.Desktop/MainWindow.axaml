<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UniversalConverter.Desktop"
        x:Class="UniversalConverter.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding Text.AppName}" Width="1060" Height="700" MinWidth="740" MinHeight="540">
  <Window.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="212,*">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="8,12,0,32" Spacing="4">
          <TextBlock Text="{Binding Text.AppName}" TextWrapping="Wrap" FontSize="26" FontWeight="Bold" />
        </StackPanel>
        <ListBox SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" SelectionMode="AlwaysSelected" VerticalAlignment="Top">
          <ListBoxItem AutomationProperties.AutomationId="NavDashboard" AutomationProperties.Name="{Binding Text.Dashboard}" Content="{Binding Text.Dashboard}" />
          <ListBoxItem AutomationProperties.AutomationId="NavConvert" AutomationProperties.Name="{Binding Text.Convert}" Content="{Binding Text.Convert}" />
          <ListBoxItem AutomationProperties.AutomationId="NavQueue" AutomationProperties.Name="{Binding Text.Queue}" Content="{Binding Text.Queue}" />
          <ListBoxItem AutomationProperties.AutomationId="NavHistory" AutomationProperties.Name="{Binding Text.History}" Content="{Binding Text.History}" />
          <ListBoxItem AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="{Binding Text.Settings}" Content="{Binding Text.Settings}" />
          <ListBoxItem AutomationProperties.AutomationId="NavAbout" AutomationProperties.Name="{Binding Text.About}" Content="{Binding Text.About}" />
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="32,28" RowSpacing="18">
      <TextBlock Classes="title" AutomationProperties.AutomationId="PageTitle" Text="{Binding PageTitle}" />
      <Border Grid.Row="1" Classes="panel" Padding="16,10">
        <TextBlock Classes="secondary" AutomationProperties.AutomationId="SimulationBanner" Text="{Binding Text.SimulationBanner}" />
      </Border>
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
        <Panel>
          <StackPanel IsVisible="{Binding IsDashboard}" Spacing="16">
            <Border Classes="panel">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Text.DashboardHeading}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Classes="secondary" Text="{Binding Text.DashboardIntro}" />
                <Button Classes="accent" Content="{Binding Text.OpenConvert}" Command="{Binding OpenConvertCommand}" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding QueueSummary}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsConvert}" Spacing="14">
            <Border Classes="panel" Background="Transparent" x:Name="DropZone" DragDrop.AllowDrop="True">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Text.DropTitle}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Classes="secondary" Text="{Binding Text.SupportedImages}" />
                <Button AutomationProperties.AutomationId="ChooseFiles" Content="{Binding Text.ChooseFiles}" Click="OnChooseFiles" />
              </StackPanel>
            </Border>
            <ListBox AutomationProperties.AutomationId="InputFiles" ItemsSource="{Binding InputFiles}" MaxHeight="180" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ComboBox AutomationProperties.Name="{Binding Text.TargetFormat}" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:TargetOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="accent" AutomationProperties.AutomationId="QueueSimulation" Content="{Binding Text.QueueSimulation}" Command="{Binding QueueSimulationCommand}" />
              <Button Content="{Binding Text.ClearFiles}" Command="{Binding ClearFilesCommand}" />
            </StackPanel>
            <TextBlock Classes="secondary" Text="{Binding InputMessage}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsQueue}" Spacing="12">
            <TextBlock Classes="secondary" Text="{Binding QueueSummary}" />
            <ItemsControl AutomationProperties.AutomationId="ActiveJobs" ItemsSource="{Binding ActiveJobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:JobRow">
                  <Border Classes="panel" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="secondary" AutomationProperties.AutomationId="JobStatus" Text="{Binding Status}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="{Binding CancelLabel}" Command="{Binding Cancel}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsHistory}" Spacing="12">
            <TextBlock Classes="secondary" Text="{Binding Text.HistoryNote}" />
            <ItemsControl AutomationProperties.AutomationId="FinishedJobs" ItemsSource="{Binding FinishedJobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:JobRow">
                  <Border Classes="panel" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="secondary" Text="{Binding Status}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsSettings}" Spacing="10">
            <TextBlock Classes="secondary" Text="{Binding SettingsLoadMessage}" />
            <TextBlock Text="{Binding Text.Language}" FontSize="20" FontWeight="SemiBold" />
            <ListBox AutomationProperties.AutomationId="LanguagePicker" AutomationProperties.Name="{Binding Text.Language}"
                     SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" SelectionMode="AlwaysSelected"
                     HorizontalAlignment="Left" IsEnabled="{Binding PreferencesLoaded}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBoxItem AutomationProperties.AutomationId="LanguageEnglish" AutomationProperties.Name="{Binding Text.EnglishName}" Content="{Binding Text.EnglishName}" />
              <ListBoxItem AutomationProperties.AutomationId="LanguageTurkish" AutomationProperties.Name="{Binding Text.TurkishName}" Content="{Binding Text.TurkishName}" />
            </ListBox>
            <TextBlock Classes="secondary" AutomationProperties.AutomationId="LanguageMessage" Text="{Binding LanguageMessage}" />
            <TextBlock Text="{Binding Text.Appearance}" FontSize="20" FontWeight="SemiBold" />
            <ComboBox AutomationProperties.Name="{Binding Text.Appearance}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                      IsEnabled="{Binding PreferencesLoaded}">
              <ComboBoxItem Content="{Binding Text.ThemeSystem}" />
              <ComboBoxItem Content="{Binding Text.ThemeLight}" />
              <ComboBoxItem Content="{Binding Text.ThemeDark}" />
            </ComboBox>
            <Button Content="{Binding Text.SaveTheme}" Command="{Binding SaveThemeCommand}" IsEnabled="{Binding PreferencesLoaded}" />
            <TextBlock Classes="secondary" Text="{Binding ThemeMessage}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsAbout}" Spacing="10">
            <TextBlock Text="{Binding Text.AppName}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Classes="secondary" Text="{Binding Text.AboutDescription}" />
            <TextBlock Classes="secondary" Text="{Binding Platform}" />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
